# Kunci rahasia untuk menandatangani cookie sesi admin & pemilih.
# PENTING: Ganti dengan string acak yang kuat (minimal 32 karakter) di lingkungan produksi!
BAWASLOS_SECRET=ganti-dengan-string-rahasia-yang-sangat-kuat-dan-acak-32-karakter

# Port aplikasi (default: 3000)
PORT=3000

# Database Cloud (Turso / LibSQL) untuk Vercel Serverless
# Di lokal (kosongkan / tidak wajib): otomatis fallback ke file lokal .data/bawaslos.db
# Di Vercel (WAJIB diisi di Project Settings > Environment Variables):
TURSO_DATABASE_URL=libsql://bawaslos-nama-database.turso.io
TURSO_AUTH_TOKEN=ey...token_dari_turso
